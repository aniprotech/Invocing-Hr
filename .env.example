# aniprotech - environment
#
# Copy to backend/.env for local work. On Railway these go in the app
# service's Variables tab (the one built from the Dockerfile, not the Postgres
# service - a variable on the database service is invisible to the app, and
# from the outside that looks identical to a wrong key).
#
# Every name here is read somewhere in backend/. Nothing is read that is not
# here. Values are all blank: fill in what you need, leave the rest.
#
# Secrets are environment-only on purpose. The operator panel shows whether
# each one is set and what it is for, but never accepts or displays a value -
# a secret readable from a web page leaks with the page. Themes, landing-page
# copy and policy live in the settings table instead, where they belong.


# ── Required in production ──────────────────────────────────────────────────

# Signs the session cookie. If this is missing the app generates one at boot
# and tries to write it to .env - which works on a machine with a real disk
# and does NOT work in a container, where the file is discarded on redeploy.
# The key then differs every boot and every session is invalidated: all your
# users are silently signed out. Set it, and never rotate it casually.
SECRET_KEY=

# Postgres. Falls back to a local SQLite file when unset, which is fine for
# development and wrong for anything else. postgres:// is rewritten to
# postgresql:// automatically, so Railway's own variable can be pasted as-is.
DATABASE_URL=

# Where the app is reachable, used to build links in emails and payment
# redirects. Without it those links point nowhere useful.
APP_BASE_URL=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=


# ── Signing in ──────────────────────────────────────────────────────────────
# Tenant sign-in is Google only. Without these nobody can get into the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hours before somebody has to sign in again, in seconds.
SESSION_MAX_AGE=86400

# Secure cookies are required over HTTPS and silently break local http - the
# browser refuses to store the session at all. Set false only for local work.
COOKIE_SECURE=true


# ── The operator ────────────────────────────────────────────────────────────
# Who may reach /superadmin.html, and the password for the form login.
SUPERADMIN_EMAILS=
SUPERADMIN_PASSWORD=

# Legacy admin login. Defaults to "admin", which is not a password.
ADMIN_PASSWORD=


# ── Money ───────────────────────────────────────────────────────────────────

# GoCardless is the only way tenants top up their wallet.
#
# Bank debit, not cards: a payment confirms rather than authorising, and the
# wallet credits when GoCardless says confirmed - never on submission. A first
# top-up legitimately sits pending for a few days.
#
# Sandbox and live are separate dashboards with separate tokens. Pointing a
# sandbox token at live returns a 401 that reads exactly like a bad key, so
# change the token and the environment together.
#
# The webhook secret is not optional. Without it every webhook is rejected,
# so payments submit and then never credit. Create the endpoint pointing at
# <APP_BASE_URL>/api/wallet/webhook/gocardless and use the secret it gives you.
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=sandbox

# Razorpay collects invoices from a tenant's customers, and takes the
# automatic charges. Webhook: <APP_BASE_URL>/api/wallet/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_INTERNATIONAL=

# Stripe and PayPal are legacy: they settle orders taken before the change to
# GoCardless and are not offered for anything new. Leave blank unless you have
# old orders outstanding.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# What the platform itself charges in. Changing this does not convert balances
# that already exist.
PLATFORM_CURRENCY=GBP
TOPUP_MIN=5
TOPUP_MAX=5000
WALLET_LOW_BALANCE=5


# ── AI ──────────────────────────────────────────────────────────────────────
# Providers are tried cheapest first and the first that answers wins. Only
# those with a key set are tried at all, so adding one is a key rather than a
# deploy - and a provider that is rate limited or out of quota is a reason to
# try the next rather than to fail.
#
# The five above OpenAI have free tiers. OpenAI is last and is billed per
# token: it is only ever reached when every free provider has failed.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# A model running on this host. Set to true to put it in the chain.
OLLAMA_ENABLED=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-provider model overrides. Blank uses the built-in default, which the AI
# status page checks against what the key can actually use - hosted models get
# retired, and a default that names a dead one takes the AI down.
GROQ_MODEL=
CEREBRAS_MODEL=
OPENROUTER_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=
OLLAMA_MODEL=

# Override the order, for quotas that make the built-in one wrong. Comma
# separated names; anything configured but unnamed still gets a turn after.
AI_PROVIDER_ORDER=

# Identical requests are answered from a short-lived cache, so the same
# question is not bought twice. 0 disables it.
AI_CACHE_TTL=3600
AI_CACHE_MAX=500


# ── Meetings ────────────────────────────────────────────────────────────────
# STUN alone only connects when both ends are directly reachable. Behind a
# corporate firewall it cannot, and the failure is the worst kind: the call
# looks connected, the tile appears, and no audio ever arrives. Our users are
# office staff, which is exactly that population.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=


# ── Sending things ──────────────────────────────────────────────────────────
FROM_EMAIL=
FROM_NAME=aniprotech
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=


# ── Background jobs ─────────────────────────────────────────────────────────
# Reminders, recurring invoices, closing abandoned shifts. Turn the scheduler
# off on a second instance, or the same job runs twice.
SCHEDULER_ENABLED=1
SCHEDULER_TICK_SECONDS=900


# ── Serving ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000


# ── Not read by anything ────────────────────────────────────────────────────
# backend/.env currently carries SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD and GOOGLE_REFRESH_TOKEN. No code reads any of them - mail
# goes out through the Google account that signed in. They are left out here
# deliberately: carrying a password nothing uses is a liability with no
# benefit, and it invites somebody to debug mail by setting them.
