{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invoicing-backend",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/main.py"
      ],
      "port": 8000
    },
    {
      "name": "frontend-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--directory",
        "frontend"
      ],
      "port": 8777
    }
  ]
}
